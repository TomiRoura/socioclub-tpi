# Copiá este archivo como ".env" (en la carpeta app-socios) y descomentá lo que necesites.
# Después de cambiar algo, reiniciá "npm start": React lee estas variables solo al arrancar.

# Modo de datos. Si no está definida, la app usa los datos locales (src/datos/datosLocales.js).
# Solo con el valor exacto "false" se conecta a la API del backend.
# REACT_APP_USAR_DATOS_LOCALES=false

# Dirección base de la API (por defecto http://localhost:8080/api).
# REACT_APP_API_URL=http://localhost:8080/api
