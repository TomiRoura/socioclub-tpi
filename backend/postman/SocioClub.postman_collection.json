              ],
              "path": [
                "actividades"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Trae las 8 actividades con cupoDisponible', function () {",
                  "    const lista = pm.response.json();",
                  "    pm.expect(lista.length).to.be.at.least(8);",
                  "    pm.expect(lista[0]).to.have.property('cupoDisponible');",
                  "});"
                ]
              }
            }
          ]
        },
